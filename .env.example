# Kunlik tibbiy yangiliklarning Telegram postidagi ijtimoiy havolalar
INSTAGRAM_URL=
YOUTUBE_URL=
TELEGRAM_SOCIAL_URL=

# Medical Content Hub (maxfiy qiymatlar Vercel'da beriladi)
NEWS_AUTO_FETCH=true
NEWS_AUTO_TELEGRAM=true
NEWS_AUTO_SITE_PUBLISH=true
NEWS_AUTO_BANNER=false
NEWS_MIN_IMPORTANCE_SCORE=70

# Vercel Production env va GitHub Actions repository secretida bir xil qiymat bo'ladi.
CRON_SECRET=
# Faqat GitHub Actions repository secreti; Vercel env emas.
MEDICAL_NEWS_CRON_URL=
