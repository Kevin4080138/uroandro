# Kunlik tibbiy yangiliklarning Telegram postidagi ijtimoiy havolalar
INSTAGRAM_URL=
YOUTUBE_URL=
TELEGRAM_SOCIAL_URL=

# Telegram postlar bo'limi: AI matn va litsenziyali rasm qidiruvi
GEMINI_API_KEY=
GEMINI_MODEL=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# EaseApi3 Pinterest Search API (RapidAPI); key is server-only.
PINTEREST_RAPIDAPI_KEY=
UNSPLASH_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy: avval webhook secret ishlatilgan bo'lsa, o'sha qiymatni kiriting.
# Bo'sh bo'lsa quiz statistikasi uchun bot tokenidan maxfiy qiymat hosil qilinadi.
TELEGRAM_WEBHOOK_SECRET=

# Medical Content Hub (maxfiy qiymatlar Vercel'da beriladi)
NEWS_AUTO_FETCH=true
NEWS_AUTO_TELEGRAM=true
NEWS_AUTO_SITE_PUBLISH=true
NEWS_AUTO_BANNER=false
NEWS_MIN_IMPORTANCE_SCORE=70

# Vercel Production env, GitHub Actions va Telegram scheduler uchun Supabase Vault'da bir xil qiymat.
CRON_SECRET=
# Faqat GitHub Actions repository secreti; Vercel env emas.
MEDICAL_NEWS_CRON_URL=
